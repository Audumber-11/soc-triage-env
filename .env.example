# Required environment variables for the SOC Alert Triage Environment

# API Base URL for the environment (default: http://localhost:8000)
API_BASE_URL=http://localhost:8000

# Model name to use for inference (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# OpenAI API Key for LLM calls
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Token (if needed for deployment)
HF_TOKEN=your_hf_token_here
